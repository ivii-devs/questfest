# ==============================================================================
# CONFIGURACIÓN DE EJEMPLO DEL BACKEND (QuestFest API)
# ==============================================================================
# Copia este archivo como '.env' en este mismo directorio y completa los valores
# reales. ¡NUNCA subas el archivo '.env' con datos reales a GitHub!

# Credenciales de la Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_DB=questfest_app

# Clave secreta para la firma y verificación de tokens de sesión JWT
# Genera una clave aleatoria y robusta (por ejemplo, con 'openssl rand -hex 32')
SECRET_KEY=tu_secret_key_32_chars

# Cadena de conexión asíncrona para SQLAlchemy y AsyncPG:
# - En Docker local: postgresql+asyncpg://postgres:tu_password@db:5432/questfest_app
# - En Vercel Serverless + Supabase (Transaction Pooler obligatorio en puerto 6543):
#   DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:tu_password@db:5432/questfest_app

# Configuración de Cloudinary para subida y almacenamiento de imágenes
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# Configuración de Notificaciones WebPush Nativas (VAPID) - Opcional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@questfest.app
