# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - QUESTFEST (Docker Compose)
# ==============================================================================
# Este archivo sirve como plantilla para el despliegue en producción (ej. Oracle Cloud).
# Para usarlo en tu servidor:
# 1. Copia este archivo a '.env' en la raíz del proyecto en el servidor:
#    cp .env.example .env
# 2. Rellena las contraseñas con valores seguros y únicos.
# 3. Arranca los contenedores:
#    docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=questfest_prod
POSTGRES_USER=questfest_admin
# Define una contraseña fuerte (mínimo 16 caracteres alfanuméricos)
POSTGRES_PASSWORD=tu_password

# ------------------------------------------------------------------------------
# 2. Seguridad y Firma de Tokens JWT
# ------------------------------------------------------------------------------
# Genera una clave aleatoria de al menos 32 bytes (ej. 'openssl rand -hex 32')
SECRET_KEY=tu_secret_key_32_chars

# ------------------------------------------------------------------------------
# 3. Política de Orígenes Permitidos (CORS)
# ------------------------------------------------------------------------------
# Dominio oficial donde estará alojada tu web para permitir peticiones HTTP
ALLOWED_ORIGINS=https://questfest.app

# ------------------------------------------------------------------------------
# 4. Almacenamiento en la Nube (Cloudinary)
# ------------------------------------------------------------------------------
# Obtenidas en tu panel de control de Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. Conexión del Frontend con la API
# ------------------------------------------------------------------------------
# En producción debe ser la URL pública accesible por los usuarios (con HTTPS)
NEXT_PUBLIC_API_URL=https://questfest.app
