# URL base pública donde se encuentra desplegado el servidor FastAPI
# En desarrollo local: http://localhost:8000
# En producción (Oracle Cloud / Dominio con HTTPS): https://tudominio.com o https://questfest.app
NEXT_PUBLIC_API_URL=http://localhost:8000
